// UML state diagram of the business object "Registration" (drawn with Graphviz; replaces the Miro version).
// Matches the prototype: BR1 … BR4, open events (Planned), cancelled events.
digraph Registration {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, bgcolor="white", pad=0.3, nodesep=0.55, ranksep=0.9];
  node  [shape=box, style="rounded,filled", fillcolor="#fffcf5", color="#2e6b45", penwidth=1.6, fontname="Helvetica", fontsize=12, margin="0.25,0.12"];
  edge  [color="#475569", fontname="Helvetica", fontsize=9.5, arrowsize=0.8];
  start [shape=circle, label="", width=0.22, style=filled, fillcolor="#1f2a22", color="#1f2a22"];
  choice [shape=diamond, label="", width=0.35, height=0.35, style=filled, fillcolor="#fffcf5"];
  final [shape=doublecircle, label="", width=0.18, style=filled, fillcolor="#1f2a22", color="#1f2a22"];
  Confirmed; Waitlisted; Planned [label="Planned\n(open event)", fillcolor="#e4eedf"];
  CheckedIn [label="Checked in"]; NoShow [label="No-show"]; Cancelled; Expired; Attended [label="Came / did not come\n(not tracked)", fillcolor="#e4eedf", fontsize=10];
  start -> choice [label="student registers\n[consent given (C08), before start (BR1)]"];
  choice -> Planned [label="[open event] / no ticket, no seat limit"];
  choice -> Confirmed [label="[free seat] / issue QR ticket"];
  choice -> Waitlisted [label="[event full] / add to queue"];
  Waitlisted -> Confirmed [label="seat freed [first in queue] /\nnew ticket, notify (BR2)"];
  Confirmed -> CheckedIn [label="ticket scanned or chosen in list\n[1 h before start … end] / +coins (BR4)"];
  Confirmed -> NoShow [label="event ends [not checked in]"];
  Confirmed -> Cancelled [label="“I can’t come” [before start] /\nfree the seat (BR1)"];
  Waitlisted -> Cancelled [label="leaves waitlist [before start]"];
  Planned -> Cancelled [label="“I won’t come” [before start]"];
  Waitlisted -> Expired [label="event starts\n[still waitlisted] (BR3)"];
  Planned -> Attended [label="event ends"];
  note [shape=note, style=filled, fillcolor="#e4eedf", color="#2e6b45", fontsize=10, label="Event cancelled by the administrator:\nevery Confirmed, Waitlisted or Planned\nregistration moves to Cancelled / notify student"];
  {rank=same; start; note;}
  CheckedIn -> final; NoShow -> final; Cancelled -> final; Expired -> final; Attended -> final;
}
