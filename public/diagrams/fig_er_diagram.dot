digraph ER { graph [rankdir=RL, splines=ortho, nodesep=0.7, ranksep=1.4, bgcolor="white", fontname="Helvetica", pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [color="#475569", penwidth=1.3, arrowsize=0.9, fontname="Helvetica", fontsize=9];
clubs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>clubs</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">UQ</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="category">category</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="room">room</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="i18n">i18n</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>users</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">UQ</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="student_id">student_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="group_name">group_name</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="role">role</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2e6b45">student | organizer | moderator | admin</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="club_id">club_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="lang">lang</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="telegram_chat_id">telegram_chat_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="telegram_code">telegram_code</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="consent_at">consent_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2e6b45">C08 consent date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>sessions</B></TD></TR><TR><TD ALIGN="LEFT" PORT="token">token</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at">expires_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>events</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="title">title</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="i18n">i18n</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">JSON</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2e6b45">EN / KK / RU texts</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="club_id">club_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="created_by">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="location">location</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="room_code">room_code</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="venue">venue</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="type">type</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="starts_at">starts_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="ends_at">ends_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="capacity">capacity</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="coins">coins</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="moderation_comment">moderation_comment</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_open">is_open</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2e6b45">open event, no seat limit</FONT></TD></TR></TABLE>>];
registrations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>registrations</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2e6b45">+ planned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_code">ticket_code</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">UQ</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="reminder_channel">reminder_channel</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="remind_day / remind_hour">remind_day / remind_hour</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="checkin_method">checkin_method</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="checked_in_at">checked_in_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
memberships [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>memberships</B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK, FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="club_id">club_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK, FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="message">message</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="decided_at">decided_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
feedback [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>feedback</B></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK, FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK, FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="rating">rating</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
coin_transactions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>coin_transactions</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="amount">amount</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="reason">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
notifications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>notifications</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="channel">channel</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="text">text</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
complaints [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2e6b45" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e4eedf"><B>complaints (new)</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="target_type">target_type</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="target_id">target_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="reason">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="text">text</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="admin_comment">admin_comment</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="handled_by">handled_by</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at / updated_at">created_at / updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2e6b45">status: new → in_review → resolved | rejected<BR ALIGN="LEFT"/>target: event or club (FR-43 … FR-45)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
telegram_chats [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2e6b45" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e4eedf"><B>telegram_chats (new)</B></TD></TR><TR><TD ALIGN="LEFT" PORT="chat_id">chat_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="lang">lang</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="await_action">await_action</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2e6b45">bot language of a chat (FR-37); answer the bot waits for (FR-47 … FR-49);<BR ALIGN="LEFT"/>chat_id = users.telegram_chat_id<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same; clubs; users;}
{rank=same; memberships; events; sessions; notifications;}
{rank=same; registrations; feedback; coin_transactions; complaints; telegram_chats;}
users -> clubs [dir=both, arrowtail=teetee, arrowhead=crowodot];
events -> clubs [dir=both, arrowtail=teetee, arrowhead=crowodot];
events -> users [dir=both, arrowtail=teeodot, arrowhead=crowodot, style=dashed];
sessions -> users [dir=both, arrowtail=teetee, arrowhead=crowodot];
registrations -> events [dir=both, arrowtail=teetee, arrowhead=crowodot];
registrations -> users [dir=both, arrowtail=crowodot, arrowhead=teetee];
memberships -> users [dir=both, arrowtail=crowodot, arrowhead=teetee];
memberships -> clubs [dir=both, arrowtail=crowodot, arrowhead=teetee];
feedback -> events [dir=both, arrowtail=crowodot, arrowhead=teetee];
feedback -> users [dir=both, arrowtail=crowodot, arrowhead=teetee];
coin_transactions -> users [dir=both, arrowtail=teetee, arrowhead=crowodot];
coin_transactions -> events [dir=both, arrowtail=crowodot, arrowhead=teetee];
notifications -> users [dir=both, arrowtail=teetee, arrowhead=crowodot];
complaints -> users [dir=both, arrowtail=crowodot, arrowhead=teetee, xlabel="author"];
complaints -> users [dir=both, arrowtail=crowodot, arrowhead=teeodot, style=dashed, xlabel="handled_by"];
complaints -> events [dir=both, arrowtail=crowodot, arrowhead=teeodot, style=dotted, color="#2e6b45", xlabel="target (event)"];
complaints -> clubs [dir=both, arrowtail=teeodot, arrowhead=crowodot, style=dotted, color="#2e6b45", xlabel="target (club)"];
telegram_chats -> users [dir=both, arrowtail=teeodot, arrowhead=teeodot, style=dotted, color="#2e6b45", xlabel="chat_id"];
}
