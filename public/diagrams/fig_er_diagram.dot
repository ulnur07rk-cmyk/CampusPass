digraph ER { graph [rankdir=RL, splines=ortho, nodesep=0.7, ranksep=1.4, bgcolor="white", fontname="Helvetica", pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [color="#475569", penwidth=1.3, arrowsize=0.9, fontname="Helvetica", fontsize=9];
clubs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>clubs</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">UQ</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="category">category</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="room">room</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="i18n">i18n</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>users</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">UQ</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="student_id">student_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="group_name">group_name</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="role">role</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="club_id">club_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="lang">lang</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="telegram_chat_id">telegram_chat_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="telegram_code">telegram_code</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>sessions</B></TD></TR><TR><TD ALIGN="LEFT" PORT="token">token</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at">expires_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>events</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="title">title</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="club_id">club_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="created_by">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="location">location</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="room_code">room_code</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="venue">venue</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="type">type</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="starts_at">starts_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="ends_at">ends_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="capacity">capacity</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="coins">coins</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="moderation_comment">moderation_comment</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
registrations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>registrations</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_code">ticket_code</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">UQ</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="reminder_channel">reminder_channel</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="remind_day / remind_hour">remind_day / remind_hour</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="checkin_method">checkin_method</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="checked_in_at">checked_in_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
memberships [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>memberships</B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK, FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="club_id">club_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK, FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="message">message</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="decided_at">decided_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
feedback [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>feedback</B></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK, FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK, FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="rating">rating</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
coin_transactions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>coin_transactions</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="amount">amount</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="reason">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
notifications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#edf3ff"><B>notifications</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">PK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">INTEGER</FONT></TD><TD ALIGN="LEFT"><B><FONT COLOR="#1f5ad6">FK</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="channel">channel</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="text">text</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5b6b82">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
{rank=same; clubs; users;}
{rank=same; memberships; events; sessions; notifications;}
{rank=same; registrations; feedback; coin_transactions;}
users -> clubs [dir=both, arrowtail=teetee, arrowhead=crowodot];
events -> clubs [dir=both, arrowtail=teetee, arrowhead=crowodot];
events -> users [dir=both, arrowtail=teeodot, arrowhead=crowodot, style=dashed];
sessions -> users [dir=both, arrowtail=teetee, arrowhead=crowodot];
registrations -> events [dir=both, arrowtail=teetee, arrowhead=crowodot];
registrations -> users [dir=both, arrowtail=crowodot, arrowhead=teetee];
memberships -> users [dir=both, arrowtail=crowodot, arrowhead=teetee];
memberships -> clubs [dir=both, arrowtail=crowodot, arrowhead=teetee];
feedback -> events [dir=both, arrowtail=crowodot, arrowhead=teetee];
feedback -> users [dir=both, arrowtail=crowodot, arrowhead=teetee];
coin_transactions -> users [dir=both, arrowtail=teetee, arrowhead=crowodot];
coin_transactions -> events [dir=both, arrowtail=crowodot, arrowhead=teetee];
notifications -> users [dir=both, arrowtail=teetee, arrowhead=crowodot];
