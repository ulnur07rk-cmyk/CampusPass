PORT=3000
DB_PATH=data/campuspass.db
SESSION_TTL_HOURS=12
# 2GIS MapGL key (free demo key from platform.2gis.ru, restricted to your domains). Empty = OpenStreetMap map.
MAPGL_KEY=
# Telegram bot token from @BotFather. Never commit it. Empty = reminders only in the in-app inbox.
TELEGRAM_BOT_TOKEN=
# 1 = localhost receives bot messages by long polling (switches the bot away from the website webhook)
TELEGRAM_POLLING=1
# Optional: https address of the website, adds "Open in CampusPass" buttons to bot messages (Netlify sets URL itself)
SITE_URL=
# Optional AI chat for the assistant (FR-50): a free Google AI Studio key (aistudio.google.com, no payment card). Never commit it.
# Empty = built-in assistant (keywords + CampusPass data). Sent to Google: the question and public event/club data, never names, e-mails or IDs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_PER_HOUR=30
