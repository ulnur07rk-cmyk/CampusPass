PORT=3000
DB_PATH=data/campuspass.db
SESSION_TTL_HOURS=12
# 2GIS MapGL key (free demo key from platform.2gis.ru, restricted to your domains). Empty = OpenStreetMap map.
MAPGL_KEY=
# Telegram bot token from @BotFather. Never commit it. Empty = reminders only in the in-app inbox.
TELEGRAM_BOT_TOKEN=
# 1 = localhost receives bot messages by long polling (switches the bot away from the website webhook)
TELEGRAM_POLLING=1
